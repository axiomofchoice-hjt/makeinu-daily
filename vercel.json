{
    "rewrites": [
        {
            "source": "/:year(\\d{4})/:month(\\d{2})/:slug+",
            "destination": "/:year/:month/:slug.html"
        },
        {
            "source": "/topic/:slug+",
            "destination": "/topic/:slug.html"
        },
        {
            "source": "/:slug+",
            "destination": "/:slug.html"
        }
    ]
}
